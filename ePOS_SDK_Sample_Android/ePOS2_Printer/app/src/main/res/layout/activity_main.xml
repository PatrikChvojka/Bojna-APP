<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.epson.epos2_printer.MainActivity">

    <!-- BACKGROUND -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_kiosk" />

    <!-- DARK OVERLAY -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#22000000" />

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"
        android:layout_marginBottom="160dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <Space
                android:layout_width="match_parent"
                android:layout_height="80dp" />

            <!-- PRINT BUTTON -->
            <LinearLayout
                android:id="@+id/btnSampleReceipt"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="#2ECC71"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/ic_printer_image" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="VSTUP"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- STATUS BAR -->
    <RelativeLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#CC000000"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:elevation="10dp"
        android:clickable="true">

        <!-- LEFT STATUS -->
        <LinearLayout
            android:id="@+id/statusLeft"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true">

            <!-- PRINTER -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="14dp">

                <View
                    android:id="@+id/statusPrinterDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="#FF0000" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Printer"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

            <!-- RASPBERRY -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="14dp">

                <View
                    android:id="@+id/statusRaspberryDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="#FF0000" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Raspberry"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

            <!-- WIFI -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/statusNetworkDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="#FF0000" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WiFi"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- SETTINGS + HELP RIGHT -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- TICKETS BUTTON -->
            <ImageView
                android:id="@+id/btnTickets"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:background="#44000000"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- HELP BUTTON -->
            <ImageView
                android:id="@+id/btnHelp"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                android:src="@android:drawable/ic_menu_help"
                android:background="#44000000"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- SETTINGS BUTTON -->
            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@android:drawable/ic_menu_preferences"
                android:background="#44000000"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </RelativeLayout>

    <!-- WARNINGS PANEL (SPODOK FIXNUTÝ) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="#66000000">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Warnings"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtWarnings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#AAFFFFFF"
            android:enabled="false"
            android:focusable="false" />

    </LinearLayout>

</FrameLayout>